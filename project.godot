; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="JanusSpire2"
config/features=PackedStringArray("4.5", "C#", "Mobile")
config/icon="res://JanusSpire2/mod_image.png"

[autoload]

FmodManager="*res://addons/fmod/FmodManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="JanusSpire2"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/fmod/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"
