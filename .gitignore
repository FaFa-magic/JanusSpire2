# 基础屏蔽
bin/

# 缓存屏蔽
# 本地验证脚本、导出包、日志与旧插件/模组备份统一放在 temp。
/temp/
obj/
/*cache/

# godot 屏蔽
.godot/

# FMOD authoring caches/build output are not mod runtime resources.
/FMOD/.cache/
/FMOD/.user/
/FMOD/.unsaved/
/FMOD/Build/
/FMOD/Logs/
# FMOD 素材由 Studio 读取，不需要 Godot 自动生成的导入描述。
/FMOD/Assets/**/*.import

# --- IDE ---
.idea/
.vscode/
.vs/
*.suo
*.user

# 其他
/packages/
riderModule.iml
/_ReSharper.Caches/

# 本地开发知识与代理约定（不提交）
/AGENTS.md
/docs/
