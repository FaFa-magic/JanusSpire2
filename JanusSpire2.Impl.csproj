<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <AssemblyName>JanusSpire2.Impl</AssemblyName>
        <RootNamespace>JanusSpire2</RootNamespace>
        <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/mod_manifest.json')), '&quot;version&quot;\s*:\s*&quot;v?([0-9.]+)&quot;').Groups[1].Value)</Version>
        <!-- This DLL is loaded by the host game on Windows, macOS and Linux. -->
        <PlatformTarget>AnyCPU</PlatformTarget>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>$(DefaultItemExcludes);packages/**;temp/**;build/**</DefaultItemExcludes>
        <RitsuLibVersion Condition="'$(RitsuLibVersion)' == ''">0.6.14</RitsuLibVersion>
        <RitsuLibAutoCopy>false</RitsuLibAutoCopy>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
    </PropertyGroup>

    <PropertyGroup>
        <IsWindows>false</IsWindows>
        <IsLinux>false</IsLinux>
        <IsOSX>false</IsOSX>
        <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
        <AutoSteamPath Condition="'$(AutoSteamPath)' == '' and '$(SteamLibraryPath)' == '' and !Exists('D:/STEAM/steamapps/common/Slay the Spire 2')">$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)\steamapps</AutoSteamPath>
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == '' and Exists('$(AutoSteamPath)/common/Slay the Spire 2')">$(AutoSteamPath)</SteamLibraryPath>
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">D:/STEAM/steamapps</SteamLibraryPath>

        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
        <GodotPath Condition="'$(GodotPath)' == ''">D:/Godot/Godot_v4.5.1-stable_mono_win64/Godot_v4.5.1-stable_mono_win64_console.exe</GodotPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/.local/share/Steam/steamapps</SteamLibraryPath>
        <GodotPath Condition="'$(GodotPath)' == ''">$(SteamLibraryPath)/common/Godot Engine/godot.x11.opt.tools.64</GodotPath>
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/Library/Application Support/Steam/steamapps</SteamLibraryPath>
        <GodotPath Condition="'$(GodotPath)' == ''">$(HOME)/Applications/Godot_mono.app/Contents/MacOS/Godot</GodotPath>
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DisableSteamworks)' == 'true'">
        <DefineConstants>$(DefineConstants);DISABLESTEAMWORKS</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <!-- The Godot editor loads Debug assemblies while exporting PCKs. -->
            <Private Condition="'$(Configuration)' == 'Debug'">true</Private>
            <Private Condition="'$(Configuration)' != 'Debug'">false</Private>
        </Reference>
        <Reference Include="Steamworks.NET" Condition="'$(DisableSteamworks)' != 'true' and Exists('$(Sts2DataDir)/Steamworks.NET.dll')">
            <HintPath>$(Sts2DataDir)/Steamworks.NET.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="STS2.RitsuLib" Version="$(RitsuLibVersion)" PrivateAssets="All" />
        <AdditionalFiles Include="JanusSpire2/localization/**/*.json"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="materials/**" />
        <Compile Remove="shaders/**" />
        <Compile Remove="images/**" />
        <Compile Remove="JanusSpire2/images/**" />
        <Compile Remove="JanusSpire2/scenes/**" />
        <Compile Remove="JanusSpire2/materials/**" />
        <Compile Remove="JanusSpire2/shaders/**" />
        <EmbeddedResource Remove="JanusSpire2/**" />
        <EmbeddedResource Remove="materials/**" />
        <EmbeddedResource Remove="shaders/**" />
        <EmbeddedResource Remove="images/**" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".gitignore"/>
        <None Update="mod_manifest.json" />
        <None Include="project.godot"/>
        <None Include="JanusSpire2/**"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="JanusSpire2/localization/eng/setting.json" LogicalName="JanusSpire2.Settings.eng.json" />
        <EmbeddedResource Include="JanusSpire2/localization/zhs/setting.json" LogicalName="JanusSpire2.Settings.zhs.json" />
        <EmbeddedResource Include="JanusSpire2/localization/jpn/setting.json" LogicalName="JanusSpire2.Settings.jpn.json" />
        <EmbeddedResource Include="JanusSpire2/localization/kor/setting.json" LogicalName="JanusSpire2.Settings.kor.json" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="JanusSpire2\images\card_portraits\big\"/>
        <Folder Include="JanusSpire2\images\packed\sprite_fonts\" />
        <Folder Include="JanusSpire2\images\powers\big\"/>
        <Folder Include="JanusSpire2\images\relics\big\"/>
        <Folder Include="JanusSpire2\scenes\vfx\energy\" />
    </ItemGroup>

    <Target Name="CheckDependencyPaths">
        <Error
                Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
                Condition="!Exists('$(Sts2DataDir)/sts2.dll')"/>
    </Target>

    <Import Project="build/Build-Bundle.targets" Condition="Exists('build/Build-Bundle.targets')" />
</Project>
